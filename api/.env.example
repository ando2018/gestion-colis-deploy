# Copier ce fichier en .env (même dossier) puis adapter les valeurs.
PORT=3000

# MongoDB en replica set (obligatoire pour les transactions) — docker-compose.yml : npm run mongo
# Atlas (cloud) : mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/gestion-colis
MONGODB_URI=mongodb://127.0.0.1:27017/gestion-colis?replicaSet=rs0

# Secret de signature des sessions : une longue chaîne aléatoire, propre à votre serveur
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
FUSEAU=Europe/Paris

# Compte de la plateforme (page /plateforme), créé au premier démarrage avec ce mot de passe provisoire
PLATEFORME_EMAIL=plateforme@colis.local
PLATEFORME_MOT_DE_PASSE=Colis2026!

# Entreprise des données existantes et son premier admin (code provisoire affiché dans la console au premier démarrage)
ENTREPRISE_DEFAUT=DEM-000-000-001
ADMIN_EMAIL=admin@colis.local

# 1 = boutons de connexion rapide (démonstration seulement), comptes de démo avec le code CODE_DEMO
DEMO=0
CODE_DEMO=1234

# 1 = affiche aussi chaque ZPL dans la console du serveur
ZPL_CONSOLE=0
